    "Als neues Filament anlegen" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create as new filament"
          }
        }
      }
    },
    "Am Drucker Einstellungen > Netzwerk > LAN-Modus einschalten (die Anycubic-Cloud ist dann aus). Mit ACE wird pro Slot abgezogen, von der Spule, die in der App an diesem Slot eingelegt ist." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the printer, turn on Settings > Network > LAN mode (the Anycubic cloud is then off). With an ACE, consumption is deducted per slot, from the spool loaded at that slot in the app."
          }
        }
      }
    },
